{
  "name": "kingdom-chronicle-desktop",
  "productName": "Kingdom Chronicle",
  "version": "0.3.9",
  "description": "Read-only desktop companion for Colony Bridge and MineColonies",
  "author": "Marko",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-WindowsAssets.ps1 -RegenerateIcon",
    "launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-WindowsAssets.ps1",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "pnpm run launcher && electron-forge make",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "6.8.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "42.7.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
